# ==============================================================================
# Environment Configuration Template (.env.example)
# Real-Time Collaborative Whiteboard
# Copy this file to .env and adjust values for your local environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application & FastAPI Server
# ------------------------------------------------------------------------------
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
API_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# JSON-encoded array or comma-separated list of allowed origins for CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Secret key used for cryptographic signing (sessions, tokens)
# Minimum 32 characters in production.
SECRET_KEY=dev-secret-key-must-be-replaced-in-production-min-32-chars!

# ------------------------------------------------------------------------------
# PostgreSQL Database (Phase 2+)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=whiteboard_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/whiteboard_db

# ------------------------------------------------------------------------------
# Mailpit (Local SMTP / Email Testing) (Phase 0+)
# ------------------------------------------------------------------------------
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# ------------------------------------------------------------------------------
# Collaboration Service (Hocuspocus / Yjs) (Phase 6+)
# ------------------------------------------------------------------------------
COLLABORATION_HOST=0.0.0.0
COLLABORATION_PORT=1234
COLLABORATION_SECRET=dev-collaboration-jwt-secret-min-32-chars-length!

# ------------------------------------------------------------------------------
# Cloudflare R2 Object Storage (S3-compatible) (Phase 5+)
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=placeholder-account-id
R2_ACCESS_KEY_ID=placeholder-access-key-id
R2_SECRET_ACCESS_KEY=placeholder-secret-access-key
R2_BUCKET_NAME=collaborative-whiteboard-assets
R2_PUBLIC_URL=https://assets.example.com

# ------------------------------------------------------------------------------
# Google OIDC Authentication (Phase 3+)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=placeholder-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=placeholder-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
